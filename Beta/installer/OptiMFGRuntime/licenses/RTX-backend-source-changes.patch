+// Create can enter the shared NGX runtime while Evaluate enters the concrete
+// DLSS-G provider directly. Bind the latter only to the already selected module
+// and generation; aggregate discovery must never authorize a different provider.
+entry_detour::Snapshot BindSelectedProviderEvaluate(entry_detour::Kind kind)
+{
+    const auto owner = reinterpret_cast<HMODULE>(
+        gActiveNgxProviderBase.load(std::memory_order_acquire));
+    const auto generation = gActiveNgxProviderGeneration.load(std::memory_order_acquire);
+    if (!owner || !generation) return {};
+    const auto candidate = entry_detour::ReadSnapshot(kind, owner);
+    if (!candidate.current || candidate.owner != owner || candidate.generation != generation)
+        return {};
+    uint64_t empty = 0;
+    gActiveNgxEvaluateHandle.compare_exchange_strong(empty,
+        PackEntryHandle(candidate.handle), std::memory_order_acq_rel);
+    return entry_detour::ReadSnapshot(UnpackEntryHandle(
+        gActiveNgxEvaluateHandle.load(std::memory_order_acquire)));
+}
