 namespace dlssg_provider_policy
 {
+bool ReadLoadedProviderVersion(HMODULE module, VersionTriplet& version) noexcept
+{
+    version = {};
+    if (!module) return false;
+    const HRSRC resource = FindResourceW(module, MAKEINTRESOURCEW(VS_VERSION_INFO), RT_VERSION);
+    if (!resource) return false;
+    const DWORD bytes = SizeofResource(module, resource);
+    const auto data = static_cast<const unsigned char*>(LockResource(LoadResource(module, resource)));
+    // VS_VERSIONINFO contains three WORDs, a terminated UTF-16 key, DWORD
+    // alignment padding and the fixed value. Bound every read by the resource.
+    constexpr wchar_t key[] = L"VS_VERSION_INFO";
+    constexpr size_t valueOffset = (3 * sizeof(WORD) + sizeof(key) + 3) & ~size_t(3);
+    if (!data || bytes < valueOffset + sizeof(VS_FIXEDFILEINFO)) return false;
+    WORD header[3]{};
+    std::memcpy(header, data, sizeof(header));
+    if (header[0] > bytes || header[0] < valueOffset + sizeof(VS_FIXEDFILEINFO)
+        || header[1] != sizeof(VS_FIXEDFILEINFO) || header[2] != 0
+        || std::memcmp(data + sizeof(header), key, sizeof(key)) != 0) return false;
+    VS_FIXEDFILEINFO fixed{};
+    std::memcpy(&fixed, data + valueOffset, sizeof(fixed));
+    if (fixed.dwSignature != VS_FFI_SIGNATURE) return false;
+    version = {HIWORD(fixed.dwFileVersionMS), LOWORD(fixed.dwFileVersionMS),
+        HIWORD(fixed.dwFileVersionLS)};
+    return true;
+}
